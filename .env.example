DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meghasales_next"
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Admin Ticket module (office-admin task tracker) — off by default; set to
# "true" to enable the nav entry, API routes, and reminder cron.
NEXT_PUBLIC_FEATURE_ADMIN_TICKET="false"

# Payroll module — off by default; Phase 0 only ships schema + permissions,
# set to "true" once Phase 1's /dashboard/payroll UI exists to actually use it.
NEXT_PUBLIC_FEATURE_PAYROLL="false"

# Web Push (VAPID) — powers the browser push notifications for admin-ticket
# deadline reminders (opt-in per user via Settings). Generate a pair with
# `npx web-push generate-vapid-keys`. The public key is intentionally
# NEXT_PUBLIC_* — it's sent to the browser as part of the subscribe call,
# it is not a secret. VAPID_PRIVATE_KEY must stay server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="generate-with-npx-web-push-generate-vapid-keys"
VAPID_PRIVATE_KEY="generate-with-npx-web-push-generate-vapid-keys"
VAPID_SUBJECT="mailto:admin@example.com"
