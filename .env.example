DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meghasales_next"
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Admin Ticket module (office-admin task tracker) — off by default; set to
# "true" to enable the nav entry, API routes, and reminder cron.
NEXT_PUBLIC_FEATURE_ADMIN_TICKET="false"

# Meetings module (MOM tracker / action items) — off by default; set to
# "true" to enable the nav entry and API routes.
NEXT_PUBLIC_FEATURE_MEETINGS="false"

# Payroll module — off by default; Phase 0 only ships schema + permissions,
# set to "true" once Phase 1's /dashboard/payroll UI exists to actually use it.
NEXT_PUBLIC_FEATURE_PAYROLL="false"

# ⚠️ All three flags above are NEXT_PUBLIC_* — Next.js inlines them into the
# client bundle at `next build` time, not at container runtime. For the
# Docker/EC2 deploy (see deploy/DEPLOYMENT.md) this .env file only covers
# local `npm run dev`; the live build additionally needs these three set in
# the compose-level .env next to docker-compose.yml (passed through as
# --build-arg) or they silently build as disabled no matter what
# .env.production says.

# Web Push (VAPID) — powers the browser push notifications for admin-ticket
# deadline reminders (opt-in per user via Settings). Generate a pair with
# `npx web-push generate-vapid-keys`. The public key is intentionally
# NEXT_PUBLIC_* — it's sent to the browser as part of the subscribe call,
# it is not a secret. VAPID_PRIVATE_KEY must stay server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="generate-with-npx-web-push-generate-vapid-keys"
VAPID_PRIVATE_KEY="generate-with-npx-web-push-generate-vapid-keys"
VAPID_SUBJECT="mailto:admin@example.com"

# Bearer token the Vercel Cron jobs in vercel.json authenticate with
# (accounting reminders, admin-ticket reminders, deadline reminders).
CRON_SECRET="generate-a-random-secret-here"

# Vercel Blob store — required for file attachments (admin-ticket, leads,
# expenses, MOM documents/voice recordings). Provision a Blob store on the
# Vercel project (or run `vercel env pull`) to get this locally; upload
# routes 503 gracefully when it's unset.
BLOB_READ_WRITE_TOKEN="vercel-blob-store-token"
