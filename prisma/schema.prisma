generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS & ACCESS CONTROL
// ============================================================

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  module      String
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Explicit join model (not Prisma's implicit many-to-many) so a user can
// hold more than one role while still matching the existing RolePermission
// convention — and so assignedAt/assignedById can be added without another
// migration. assignedById is a plain Int (no relation), same decoupling
// pattern as AdminTicket.assignedToId below, so deactivating/deleting the
// assigning admin never blocks or cascades onto this row.
model UserRole {
  userId       Int      @map("user_id")
  roleId       Int      @map("role_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  assignedById Int?     @map("assigned_by_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  password    String
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  phone       String?
  avatarUrl   String?   @map("avatar_url")
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  roles UserRole[]

  // Relations
  assignedLeads     Lead[]             @relation("AssignedBA")
  createdLeads      Lead[]             @relation("CreatedBy")
  leadActivities    LeadActivity[]
  loggedFollowUps   LeadFollowUp[]     @relation("LeadFollowUpLoggedBy")
  assignedDemos     Demo[]
  auditLogs         AuditLog[]
  implementations   Implementation[]   @relation("ProjectManager")
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  employee          Employee?

  // Event Management
  createdEvents            Event[]                @relation("EventCreatedBy")
  uploadedEventDocuments   EventDocument[]        @relation("EventDocumentUploadedBy")
  uploadedEventDocVersions EventDocumentVersion[] @relation("EventDocumentVersionUploadedBy")
  authoredDiscussions      EventDiscussion[]      @relation("EventDiscussionAuthor")
  assignedDiscussions      EventDiscussion[]      @relation("EventDiscussionAssignedTo")

  // Accounting
  managedInvoices        Invoice[]               @relation("InvoiceAccountManager")
  createdInvoices        Invoice[]               @relation("InvoiceCreatedBy")
  updatedInvoices        Invoice[]               @relation("InvoiceUpdatedBy")
  recordedPayments       Payment[]               @relation("PaymentRecordedBy")
  reminderFollowUps      PaymentReminder[]       @relation("ReminderFollowedUpBy")
  issuedCreditNotes      CreditNote[]            @relation("CreditNoteIssuedBy")
  createdExchangeRates   ExchangeRate[]          @relation("ExchangeRateCreatedBy")
  recordedExpenses       Expense[]               @relation("ExpenseRecordedBy")
  approvedExpenseBudgets ExpenseBudget[]         @relation("ExpenseBudgetApprovedBy")
  createdExpenseBudgets  ExpenseBudget[]         @relation("ExpenseBudgetCreatedBy")
  revisedExpenseBudgets  ExpenseBudgetRevision[] @relation("ExpenseBudgetRevisedBy")
  headOfVerticals        Vertical[]              @relation("VerticalHead")
  createdCompanies       Company[]               @relation("CompanyCreatedBy")

  @@map("users")
}

// ============================================================
// CUSTOMER COMPANY MASTER
// ============================================================

// The customer-facing "company" master — e.g. "Tekfilo". Previously
// companyName was just a free-text string on Lead with no shared identity
// across deals/countries; this groups every Lead/Quotation belonging to the
// same real-world company, and is the parent for its per-country legal
// entities below.
model Company {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdById Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy     User?                @relation("CompanyCreatedBy", fields: [createdById], references: [id])
  legalEntities CompanyLegalEntity[]
  leads         Lead[]

  @@map("companies")
}

// One row per country a Company is legally registered in — e.g. Tekfilo
// India, Tekfilo Hong Kong, Tekfilo China — each with its own registered
// address, tax registration number, and documents (see EventDocument.
// legalEntityId). A Lead/Quotation links to a specific entity to know which
// jurisdiction's billing details (address, tax number) apply to that deal.
model CompanyLegalEntity {
  id                    Int      @id @default(autoincrement())
  companyId             Int      @map("company_id")
  countryId             Int      @map("country_id")
  legalName             String   @map("legal_name")
  registrationNumber    String?  @map("registration_number")
  taxRegistrationNumber String?  @map("tax_registration_number")
  addressLine1          String?  @map("address_line1")
  addressLine2          String?  @map("address_line2")
  city                  String?
  state                 String?
  postalCode            String?  @map("postal_code")
  currencyCode          String?  @map("currency_code")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  country    Country         @relation(fields: [countryId], references: [id])
  leads      Lead[]
  quotations Quotation[]
  invoices   Invoice[]
  documents  EventDocument[]

  // A company can be registered at most once per country — a second
  // registration in the same jurisdiction would be a data-entry mistake,
  // not a second legal entity.
  @@unique([companyId, countryId])
  @@index([companyId])
  @@map("company_legal_entities")
}

// ============================================================
// LEADS & OPPORTUNITIES
// ============================================================

model Lead {
  id                    Int      @id @default(autoincrement())
  companyName           String   @map("company_name")
  contactPerson         String   @map("contact_person")
  mobile                String?
  email                 String?
  country               String?
  state                 String?
  city                  String?
  countryId             Int?     @map("country_id")
  currencyCode          String?  @map("currency_code")
  currencySymbol        String?  @map("currency_symbol")
  taxType               String?  @map("tax_type")
  // Optional link to the Customer Company Master — which real-world company
  // this deal belongs to, and (if set) which of that company's per-country
  // legal entities it's specifically with. Both stay optional: existing
  // Leads/Customers keep working exactly as before via their own
  // companyName/country/state/city fields when neither is set.
  companyId             Int?     @map("company_id")
  legalEntityId         Int?     @map("legal_entity_id")
  jewelleryBusinessType String?  @map("jewellery_business_type")
  numberOfBranches      Int?     @map("number_of_branches")
  existingErp           String?  @map("existing_erp")
  leadSource            String   @map("lead_source")
  assignedBaId          Int?     @map("assigned_ba_id")
  status                String   @default("NEW")
  // Lifecycle status once a Lead has become a Customer (status=CONFIRMED) —
  // ACTIVE | INACTIVE | ON_HOLD (see src/lib/customerStatus.ts). Deliberately
  // a separate field from `status` above: `status` is the lead pipeline
  // stage (and CONFIRMED is what makes a Lead show up as a Customer at all),
  // while this tracks whether an already-converted customer is currently
  // doing business with us. Defaults to ACTIVE for every row, but is only
  // surfaced/editable on the Customers page.
  customerStatus        String   @default("ACTIVE") @map("customer_status")
  businessVerticals     String?  @map("business_verticals")
  notes                 String?
  createdById           Int?     @map("created_by")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Denormalized follow-up tracking (kept in sync whenever a LeadFollowUp is
  // logged) so the leads list can filter/sort on "last contacted" and flag
  // overdue follow-ups without a per-row subquery against lead_follow_ups.
  lastFollowUpDate DateTime? @map("last_follow_up_date")
  nextFollowUpDate DateTime? @map("next_follow_up_date")
  followUpCount    Int       @default(0) @map("follow_up_count")

  assignedBa      User?               @relation("AssignedBA", fields: [assignedBaId], references: [id])
  createdBy       User?               @relation("CreatedBy", fields: [createdById], references: [id])
  countryRef      Country?            @relation(fields: [countryId], references: [id])
  company         Company?            @relation(fields: [companyId], references: [id])
  legalEntity     CompanyLegalEntity? @relation(fields: [legalEntityId], references: [id])
  activities      LeadActivity[]
  followUps       LeadFollowUp[]
  demos           Demo[]
  quotations      Quotation[]
  implementations Implementation[]
  invoices        Invoice[]
  creditNotes     CreditNote[]
  events          Event[]
  documents       EventDocument[]

  // The leads list's default (unfiltered) view sorts by createdAt, the
  // dashboard stats widget counts by status/leadSource/nextFollowUpDate on
  // every page load, and the on-demand deadline-reminder scan (piggybacked
  // on every GET /api/leads) filters on nextFollowUpDate + assignedBaId —
  // this model had zero indexes beyond its primary key despite all of that,
  // forcing a full table scan on every one of those queries.
  @@index([createdAt])
  @@index([status])
  @@index([leadSource])
  @@index([assignedBaId])
  @@index([nextFollowUpDate])
  @@index([lastFollowUpDate])
  @@index([companyId])
  @@index([legalEntityId])
  @@map("leads")
}

model LeadFollowUp {
  id               Int       @id @default(autoincrement())
  leadId           Int       @map("lead_id")
  followUpDate     DateTime  @map("follow_up_date")
  method           String // CALL | EMAIL | VISIT | WHATSAPP | OTHER
  notes            String?
  outcome          String? // INTERESTED | NOT_REACHED | CALLBACK_REQUESTED | NEEDS_MORE_INFO | NOT_INTERESTED | CONVERTED
  nextAction       String?   @map("next_action")
  nextFollowUpDate DateTime? @map("next_followup_date")
  loggedById       Int?      @map("logged_by")
  createdAt        DateTime  @default(now()) @map("created_at")

  lead     Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  loggedBy User? @relation("LeadFollowUpLoggedBy", fields: [loggedById], references: [id])

  @@index([leadId])
  @@index([nextFollowUpDate])
  @@map("lead_follow_ups")
}

model LeadActivity {
  id            Int      @id @default(autoincrement())
  leadId        Int      @map("lead_id")
  activityType  String   @map("activity_type")
  description   String?
  performedById Int?     @map("performed_by")
  createdAt     DateTime @default(now()) @map("created_at")

  lead        Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  performedBy User? @relation(fields: [performedById], references: [id])

  @@map("lead_activities")
}

model Demo {
  id                    Int       @id @default(autoincrement())
  leadId                Int       @map("lead_id")
  demoType              String    @map("demo_type")
  assignedToId          Int?      @map("assigned_to")
  scheduledDate         DateTime? @map("scheduled_date")
  actualDate            DateTime? @map("actual_date")
  status                String    @default("SCHEDULED")
  attendees             String?
  modulesDemonstrated   String?   @map("modules_demonstrated")
  customerInterestLevel String?   @map("customer_interest_level")
  questions             String?
  nextAction            String?   @map("next_action")
  feedback              String?
  recordingUrl          String?   @map("recording_url")
  stakeholderFeedback   String?   @map("stakeholder_feedback")
  approvalStatus        String?   @default("PENDING") @map("approval_status")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  lead       Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User? @relation(fields: [assignedToId], references: [id])

  @@map("demos")
}

// ============================================================
// EVENT MANAGEMENT (available once a Lead is CONFIRMED)
// ============================================================

model Event {
  id            Int       @id @default(autoincrement())
  leadId        Int       @map("lead_id")
  title         String
  eventType     String    @map("event_type")
  // MEETING | PHONE_CALL | VIDEO_CALL | CLIENT_VISIT | INTERNAL_DISCUSSION |
  // FOLLOW_UP | REQUIREMENT_GATHERING | DOCUMENT_REVIEW | DEMO | OTHER
  eventDateTime DateTime  @map("event_date_time")
  duration      Int? // minutes
  participants  String? // free-text, mirrors Demo.attendees
  location      String?
  meetingLink   String?   @map("meeting_link")
  description   String?
  nextAction    String?   @map("next_action")
  followUpDate  DateTime? @map("follow_up_date")
  status        String    @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED
  createdById   Int?      @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  lead        Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy   User?             @relation("EventCreatedBy", fields: [createdById], references: [id])
  documents   EventDocument[]
  discussions EventDiscussion[]

  @@index([leadId])
  @@index([status])
  @@index([eventDateTime])
  @@map("events")
}

// One row per logical document "slot"; EventDocumentVersion holds the
// append-only upload history so "replace" never loses older files.
// eventId XOR discussionId is set — enforced at the route layer since no
// existing model in this schema uses a DB CHECK constraint.
model EventDocument {
  id            Int      @id @default(autoincrement())
  eventId       Int?     @map("event_id")
  discussionId  Int?     @map("discussion_id")
  // Lead-level document — no Event required. Exactly one of eventId/
  // discussionId/leadId/legalEntityId is expected to be set (enforced in
  // application code, not a DB constraint, matching how eventId/
  // discussionId already coexist here).
  leadId        Int?     @map("lead_id")
  // Company legal entity document — incorporation certificate, tax
  // registration certificate, etc., scoped to one country entity rather
  // than the Lead broadly (a company may have several).
  legalEntityId Int?     @map("legal_entity_id")
  fileName      String   @map("file_name") // kept in sync with latest version
  description   String?
  mimeType      String?  @map("mime_type")
  uploadedById  Int?     @map("uploaded_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  event       Event?                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  discussion  EventDiscussion?       @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  lead        Lead?                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  legalEntity CompanyLegalEntity?    @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  uploadedBy  User?                  @relation("EventDocumentUploadedBy", fields: [uploadedById], references: [id])
  versions    EventDocumentVersion[]

  @@index([eventId])
  @@index([discussionId])
  @@index([leadId])
  @@index([legalEntityId])
  @@map("event_documents")
}

model EventDocumentVersion {
  id              Int      @id @default(autoincrement())
  eventDocumentId Int      @map("event_document_id")
  versionNumber   Int      @map("version_number")
  fileUrl         String   @map("file_url") // Vercel Blob URL for this version
  fileName        String   @map("file_name")
  fileType        String?  @map("file_type") // extension, e.g. "pdf"
  mimeType        String?  @map("mime_type")
  fileSize        Int?     @map("file_size") // bytes
  uploadedById    Int?     @map("uploaded_by")
  uploadedAt      DateTime @default(now()) @map("uploaded_at")

  eventDocument EventDocument @relation(fields: [eventDocumentId], references: [id], onDelete: Cascade)
  uploadedBy    User?         @relation("EventDocumentVersionUploadedBy", fields: [uploadedById], references: [id])

  @@unique([eventDocumentId, versionNumber])
  @@index([eventDocumentId])
  @@map("event_document_versions")
}

model EventDiscussion {
  id               Int       @id @default(autoincrement())
  eventId          Int       @map("event_id")
  authorId         Int?      @map("author_id")
  notes            String
  decisionsTaken   String?   @map("decisions_taken")
  actionItems      String?   @map("action_items")
  assignedToId     Int?      @map("assigned_to")
  targetDate       DateTime? @map("target_date")
  completionStatus String    @default("OPEN") @map("completion_status") // OPEN | IN_PROGRESS | COMPLETED
  createdAt        DateTime  @default(now()) @map("created_at") // = discussion date/time
  updatedAt        DateTime  @updatedAt @map("updated_at")

  event       Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author      User?           @relation("EventDiscussionAuthor", fields: [authorId], references: [id])
  assignedTo  User?           @relation("EventDiscussionAssignedTo", fields: [assignedToId], references: [id])
  attachments EventDocument[]

  // completionStatus/targetDate/assignedToId are exactly the columns the
  // on-demand deadline-reminder scan filters on (piggybacked on every
  // GET /api/leads) — previously unindexed, forcing a full table scan.
  @@index([eventId])
  @@index([createdAt])
  @@index([completionStatus])
  @@index([targetDate])
  @@index([assignedToId])
  @@map("event_discussions")
}

// ============================================================
// QUOTATIONS
// ============================================================

model Quotation {
  id                    Int       @id @default(autoincrement())
  leadId                Int       @map("lead_id")
  quotationNumber       String    @unique @map("quotation_number")
  softwareModules       Json?     @map("software_modules")
  businessModule        String?   @map("business_module")
  implementationCost    Decimal?  @map("implementation_cost") @db.Decimal(15, 2)
  trainingCost          Decimal?  @map("training_cost") @db.Decimal(15, 2)
  annualMaintenance     Decimal?  @map("annual_maintenance") @db.Decimal(15, 2)
  customDevelopmentCost Decimal?  @map("custom_development_cost") @db.Decimal(15, 2)
  discountPercentage    Decimal?  @map("discount_percentage") @db.Decimal(5, 2)
  discountAmount        Decimal?  @map("discount_amount") @db.Decimal(15, 2)
  taxPercentage         Decimal?  @map("tax_percentage") @db.Decimal(5, 2)
  taxAmount             Decimal?  @map("tax_amount") @db.Decimal(15, 2)
  taxInclusive          Boolean   @default(false) @map("tax_inclusive")
  totalAmount           Decimal?  @map("total_amount") @db.Decimal(15, 2)
  validUntil            DateTime? @map("valid_until")
  status                String    @default("DRAFT")
  version               Int       @default(1)
  clientCountry         String?   @map("client_country")
  clientState           String?   @map("client_state")
  clientCity            String?   @map("client_city")
  currencyCode          String?   @default("INR") @map("currency_code")
  exchangeRate          Decimal?  @default(1) @map("exchange_rate") @db.Decimal(15, 6)
  taxBreakdown          Json?     @map("tax_breakdown")
  addons                Json?
  pricingSnapshot       Json?     @map("pricing_snapshot")
  notes                 String?
  createdById           Int?      @map("created_by")
  approvedById          Int?      @map("approved_by")
  customerApprovedAt    DateTime? @map("customer_approved_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Resource-based costing mode (Quotation Calculator) — additive alongside
  // the catalog/module-driven fields above. costingMode discriminates which
  // set of fields is meaningful for a given row; resource line items and the
  // admin/markup input config live in pricingSnapshot (matching this model's
  // existing convention of storing calculator input/output as Json rather
  // than a normalized child table — see softwareModules/addons above).
  costingMode           String   @default("CATALOG") @map("costing_mode")
  projectName           String?  @map("project_name")
  verticalId            Int?     @map("vertical_id")
  // Which of the lead's Company's per-country legal entities this
  // quotation bills to — its registered address/tax number print on the
  // quotation PDF instead of the lead's own denormalized country/state/city.
  // Optional: quotations for a lead with no Company (or no entity picked)
  // keep working exactly as before.
  legalEntityId         Int?     @map("legal_entity_id")
  resourceCostTotal     Decimal? @map("resource_cost_total") @db.Decimal(15, 2)
  outsourcingCost       Decimal? @map("outsourcing_cost") @db.Decimal(15, 2)
  travelCost            Decimal? @map("travel_cost") @db.Decimal(15, 2)
  adminCost             Decimal? @map("admin_cost") @db.Decimal(15, 2)
  markupPercentage      Decimal? @map("markup_percentage") @db.Decimal(5, 2)
  markupAmount          Decimal? @map("markup_amount") @db.Decimal(15, 2)
  marginPercent         Decimal? @map("margin_percent") @db.Decimal(5, 2)
  calculatedTotalAmount Decimal? @map("calculated_total_amount") @db.Decimal(15, 2)
  totalAmountOverridden Boolean  @default(false) @map("total_amount_overridden")

  lead        Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  vertical    Vertical?           @relation(fields: [verticalId], references: [id])
  legalEntity CompanyLegalEntity? @relation(fields: [legalEntityId], references: [id])
  invoices    Invoice[]

  @@index([legalEntityId])
  @@map("quotations")
}

// ============================================================
// IMPLEMENTATIONS
// ============================================================

model Implementation {
  id               Int       @id @default(autoincrement())
  leadId           Int       @map("lead_id")
  projectName      String?   @map("project_name")
  projectManagerId Int?      @map("project_manager_id")
  status           String    @default("PLANNING")
  startDate        DateTime? @map("start_date")
  targetEndDate    DateTime? @map("target_end_date")
  actualEndDate    DateTime? @map("actual_end_date")
  currentStage     String?   @map("current_stage")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  lead           Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectManager User? @relation("ProjectManager", fields: [projectManagerId], references: [id])

  @@map("implementations")
}

// ============================================================
// QUOTATION CONFIGURATION
// ============================================================

model QuotationModuleConfig {
  id                    Int      @id @default(autoincrement())
  moduleCode            String   @unique @map("module_code")
  moduleName            String   @map("module_name")
  description           String?
  isActive              Boolean  @default(true) @map("is_active")
  defaultCurrency       String   @default("INR") @map("default_currency")
  defaultCountry        String   @default("IN") @map("default_country")
  baseLicenseCost       Decimal  @default(0) @map("base_license_cost") @db.Decimal(15, 2)
  additionalUserCost    Decimal  @default(0) @map("additional_user_cost") @db.Decimal(15, 2)
  additionalBranchCost  Decimal  @default(0) @map("additional_branch_cost") @db.Decimal(15, 2)
  additionalCompanyCost Decimal  @default(0) @map("additional_company_cost") @db.Decimal(15, 2)
  implementationCost    Decimal  @default(0) @map("implementation_cost") @db.Decimal(15, 2)
  dataMigrationCost     Decimal  @default(0) @map("data_migration_cost") @db.Decimal(15, 2)
  trainingCost          Decimal  @default(0) @map("training_cost") @db.Decimal(15, 2)
  customDevelopmentCost Decimal  @default(0) @map("custom_development_cost") @db.Decimal(15, 2)
  cloudHostingCost      Decimal  @default(0) @map("cloud_hosting_cost") @db.Decimal(15, 2)
  annualMaintenanceCost Decimal  @default(0) @map("annual_maintenance_cost") @db.Decimal(15, 2)
  supportCharges        Decimal  @default(0) @map("support_charges") @db.Decimal(15, 2)
  oneTimeSetupFee       Decimal  @default(0) @map("one_time_setup_fee") @db.Decimal(15, 2)
  includedUsers         Int      @default(5) @map("included_users")
  includedBranches      Int      @default(1) @map("included_branches")
  includedCompanies     Int      @default(1) @map("included_companies")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("quotation_module_config")
}

model QuotationAddonConfig {
  id          Int      @id @default(autoincrement())
  addonCode   String   @unique @map("addon_code")
  addonName   String   @map("addon_name")
  description String?
  price       Decimal  @default(0) @db.Decimal(15, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("quotation_addon_config")
}

// ============================================================
// TAX & CURRENCY
// ============================================================

model CountryTaxMaster {
  id            Int       @id @default(autoincrement())
  countryCode   String    @map("country_code")
  countryName   String    @map("country_name")
  taxName       String    @map("tax_name")
  taxType       String    @map("tax_type")
  defaultRate   Decimal   @default(0) @map("default_rate") @db.Decimal(6, 3)
  isActive      Boolean   @default(true) @map("is_active")
  effectiveFrom DateTime? @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  currencyCode  String?   @map("currency_code")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([countryCode, taxName, effectiveFrom])
  @@map("country_tax_master")
}

model StateTaxMaster {
  id            Int       @id @default(autoincrement())
  countryCode   String    @map("country_code")
  stateCode     String    @map("state_code")
  stateName     String    @map("state_name")
  taxName       String    @map("tax_name")
  taxType       String    @map("tax_type")
  rate          Decimal   @default(0) @db.Decimal(6, 3)
  isActive      Boolean   @default(true) @map("is_active")
  effectiveFrom DateTime? @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([countryCode, stateCode, taxName, effectiveFrom])
  @@map("state_tax_master")
}

model CurrencyMaster {
  id                Int      @id @default(autoincrement())
  currencyCode      String   @unique @map("currency_code")
  currencyName      String   @map("currency_name")
  currencySymbol    String   @map("currency_symbol")
  decimalPlaces     Int      @default(2) @map("decimal_places")
  exchangeRateToInr Decimal  @default(1) @map("exchange_rate_to_inr") @db.Decimal(15, 6)
  isBase            Boolean  @default(false) @map("is_base")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("currency_master")
}

// Direction convention: rate = units of `toCurrency` per 1 unit of
// `fromCurrency` (matches CurrencyMaster.exchangeRateToInr's existing
// direction, e.g. fromCurrency=USD, toCurrency=INR, rate=83.5).
// Append-only — never UPDATE a row, only INSERT a new one.
model ExchangeRate {
  id           Int      @id @default(autoincrement())
  fromCurrency String   @map("from_currency")
  toCurrency   String   @map("to_currency")
  rate         Decimal  @db.Decimal(18, 8)
  rateDate     DateTime @map("rate_date") @db.Date
  rateType     String   @map("rate_type") // SPOT | DAILY | MONTHLY_AVG | MANUAL
  source       String?
  createdById  Int?     @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  createdBy User? @relation("ExchangeRateCreatedBy", fields: [createdById], references: [id])

  @@unique([fromCurrency, toCurrency, rateDate, rateType])
  @@map("exchange_rates")
}

// Canonical country picklist + default currency/tax for UI dropdowns and
// quick display. Not a replacement for CountryTaxMaster/StateTaxMaster,
// which continue to drive the actual GST/VAT calculation math — this table
// only supplies defaults (e.g. what a new Lead/Quotation starts with).
model Country {
  id                   Int      @id @default(autoincrement())
  countryName          String   @map("country_name")
  isoCode              String   @unique @map("iso_code")
  currencyCode         String   @map("currency_code")
  currencyName         String   @map("currency_name")
  currencySymbol       String   @map("currency_symbol")
  defaultTaxType       String   @map("default_tax_type") // GST | VAT | NONE
  defaultTaxPercentage Decimal  @default(0) @map("default_tax_percentage") @db.Decimal(5, 2)
  flagEmoji            String?  @map("flag_emoji")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  leads                Lead[]
  companyProfiles      CompanyProfile[]
  companyLegalEntities CompanyLegalEntity[]

  @@map("countries")
}

// ============================================================
// COMPANY PROFILE
// ============================================================

model CompanyProfile {
  id                    Int      @id @default(autoincrement())
  companyName           String   @map("company_name")
  tagline               String?
  logoUrl               String?  @map("logo_url")
  addressLine1          String?  @map("address_line1")
  addressLine2          String?  @map("address_line2")
  city                  String?
  state                 String?
  country               String?
  postalCode            String?  @map("postal_code")
  phone                 String?
  email                 String?
  website               String?
  gstNumber             String?  @map("gst_number")
  panNumber             String?  @map("pan_number")
  bankName              String?  @map("bank_name")
  bankAccountNumber     String?  @map("bank_account_number")
  bankIfsc              String?  @map("bank_ifsc")
  authorizedSignatory   String?  @map("authorized_signatory")
  signatoryDesignation  String?  @map("signatory_designation")
  primaryColor          String?  @default("#1E3A5F") @map("primary_color")
  secondaryColor        String?  @default("#D4AF37") @map("secondary_color")
  termsAndConditions    String?  @map("terms_and_conditions")
  paymentTerms          String?  @map("payment_terms")
  warrantyTerms         String?  @map("warranty_terms")
  assumptions           String?
  exclusions            String?
  confidentialityNotice String?  @map("confidentiality_notice")
  supplierStateCode     String?  @default("TN") @map("supplier_state_code")
  defaultCountryId      Int?     @map("default_country_id")
  isActive              Boolean  @default(true) @map("is_active")
  // Payroll statutory identifiers — the business's own GST/PAN/bank details
  // already exist above; these four are specifically what Payroll's
  // compliance reports (PF/ESI/PT/TDS) need and nothing else in the app uses.
  tanNumber             String?  @map("tan_number")
  pfEstablishmentCode   String?  @map("pf_establishment_code")
  esiEstablishmentCode  String?  @map("esi_establishment_code")
  ptRegistrationNumber  String?  @map("pt_registration_number")
  // Payroll Phase 4 — the actual rates/thresholds the run engine applies
  // (see SalaryComponent.statutoryType). Nullable ceiling/threshold means
  // "no cap" — a company that pays PF on full actual basic rather than
  // the statutory-minimum wage base would clear pfWageCeiling to null.
  // Employer-side rates exist here (not as their own payslip line items,
  // which would incorrectly reduce net pay) purely so compliance reports
  // can show the employer's contribution alongside what was actually
  // deducted from the employee.
  pfWageCeiling         Decimal? @default(15000) @map("pf_wage_ceiling") @db.Decimal(12, 2)
  pfEmployerRate        Decimal? @default(12) @map("pf_employer_rate") @db.Decimal(5, 2)
  esiGrossThreshold     Decimal? @default(21000) @map("esi_gross_threshold") @db.Decimal(12, 2)
  esiEmployerRate       Decimal? @default(3.25) @map("esi_employer_rate") @db.Decimal(5, 2)
  // Time & Attendance — which Saturdays are a weekly off, not every-Saturday
  // (the common alternate-Saturday policy at Indian companies). Sunday is
  // always off regardless of this setting; only Saturday's treatment
  // varies. NONE | ALL | FIRST_THIRD | SECOND_FOURTH — see
  // isWeeklyOff() in timesheetEngine.ts for how each is interpreted.
  // Defaults to SECOND_FOURTH, the most common convention.
  weeklyOffSaturdays    String   @default("SECOND_FOURTH") @map("weekly_off_saturdays")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  defaultCountry Country? @relation(fields: [defaultCountryId], references: [id])

  @@map("company_profile")
}

// ============================================================
// NOTIFICATIONS & STATUS
// ============================================================

model Notification {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  title      String
  message    String?
  type       String
  channel    String
  entityType String?   @map("entity_type")
  entityId   Int?      @map("entity_id")
  isRead     Boolean   @default(false) @map("is_read")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// Dedup key for the deadline-reminder dispatcher (events, lead follow-ups,
// event-discussion action items) — one row per (entity, stage) actually
// delivered, so the once-daily cron and the on-demand dispatch hooked into
// the leads list route never re-send the same escalation on every run.
// NOTIFIED fires once an item is discovered inside the reminder window;
// EMAILED fires once it's within 24h of its due date. No FK to a specific
// entity table since entityType spans three unrelated models.
model DeadlineReminderLog {
  id         Int      @id @default(autoincrement())
  entityType String   @map("entity_type") // EVENT | LEAD_FOLLOW_UP | EVENT_DISCUSSION
  entityId   Int      @map("entity_id")
  stage      String // NOTIFIED | EMAILED
  sentAt     DateTime @default(now()) @map("sent_at")

  @@unique([entityType, entityId, stage])
  @@map("deadline_reminder_logs")
}

// Singleton (single active row) SMTP configuration for outbound mail —
// currently only used for the deadline-reminder email escalation. Zoho
// Mail is the only provider the settings UI exposes, but the shape is
// plain SMTP so any provider works. smtpPassword is a Zoho app-specific
// password stored so the server can authenticate — the settings API never
// returns it, only whether one is set, mirroring how User password updates
// already omit the value on read.
model EmailConfig {
  id           Int      @id @default(autoincrement())
  smtpHost     String   @default("smtp.zoho.com") @map("smtp_host")
  smtpPort     Int      @default(465) @map("smtp_port")
  smtpSecure   Boolean  @default(true) @map("smtp_secure") // true = implicit TLS (port 465), false = STARTTLS (587)
  smtpUser     String?  @map("smtp_user")
  smtpPassword String?  @map("smtp_password")
  fromEmail    String?  @map("from_email")
  fromName     String?  @default("MeghaSales") @map("from_name")
  isActive     Boolean  @default(false) @map("is_active")
  updatedAt    DateTime @updatedAt @map("updated_at")
  updatedById  Int?     @map("updated_by_id") // loose ref to User.id, same convention as AdminTicketActivity.performedById

  @@map("email_config")
}

// One browser/device subscription per row — a user who opts in on both
// their phone and laptop gets two rows and a push fanned out to both.
// endpoint is unique because the browser hands out one per subscription;
// re-subscribing (e.g. after clearing site data) naturally lands a fresh
// endpoint rather than colliding with the old one.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// Payroll Phase 0 — the payroll-eligible HR profile for an existing User.
// Kept as its own 1:1 table rather than columns on User: User is pure
// identity/auth (see its own fields) and every other module already reads
// it that way, so bolting salary/bank/statutory fields directly onto it
// would leak payroll-sensitive data into every query that just needs a
// name for a dropdown. A User only gets an Employee row once someone
// actually onboards them into payroll (Phase 1) — plenty of Users (e.g.
// a demo login) will never have one.
model Employee {
  id                Int       @id @default(autoincrement())
  // Optional — most staff never need CRM login access, but still need a
  // payroll record. When onboarding finds a User with a matching email,
  // this gets linked automatically (enabling that person's self-service
  // My Payslips/My Leave); otherwise the employee is payroll-only and HR-
  // managed. firstName/lastName/email live on Employee itself rather than
  // being read through this relation, precisely so they don't require it.
  userId            Int?      @unique @map("user_id")
  employeeCode      String    @unique @map("employee_code")
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  email             String    @map("email")
  department        String?
  designation       String?
  dateOfJoining     DateTime? @map("date_of_joining")
  dateOfLeaving     DateTime? @map("date_of_leaving")
  employmentType    String    @default("FULL_TIME") @map("employment_type") // FULL_TIME | PART_TIME | CONTRACT | INTERN
  panNumber         String?   @map("pan_number")
  uanNumber         String?   @map("uan_number") // PF Universal Account Number
  esicNumber        String?   @map("esic_number")
  bankAccountNumber String?   @map("bank_account_number")
  bankIfsc          String?   @map("bank_ifsc")
  bankAccountHolder String?   @map("bank_account_holder")
  bankName          String?   @map("bank_name")
  taxRegime         String    @default("NEW") @map("tax_regime") // OLD | NEW
  pfApplicable      Boolean   @default(true) @map("pf_applicable")
  esiApplicable     Boolean   @default(false) @map("esi_applicable")
  ptApplicable      Boolean   @default(true) @map("pt_applicable")
  status            String    @default("ACTIVE") // ACTIVE | ON_NOTICE | EXITED
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user              User?                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  salaryAssignments SalaryStructureAssignment[]
  payslips          Payslip[]
  leaveRequests     LeaveRequest[]
  loans             Loan[]
  timesheetEntries  TimesheetEntry[]

  @@map("employees")
}

// Payroll Phase 1 — a named, reusable pay-slip line item (Basic, HRA,
// Employer PF, ...). `code` is the stable programmatic handle Phase 2's
// run engine will look up ("find the BASIC component's resolved value on
// this structure") rather than matching on the free-text `name`, which is
// editable and not guaranteed unique in spirit even though the DB enforces
// it. isStatutory marks components a payroll admin can edit the value of
// but shouldn't be able to delete (PF/ESI/PT) — enforced in the API layer,
// not the schema.
model SalaryComponent {
  id              Int      @id @default(autoincrement())
  name            String
  code            String   @unique
  type            String // EARNING | DEDUCTION
  calculationType String   @default("FLAT") @map("calculation_type") // FLAT | PERCENT_OF_BASIC
  isStatutory     Boolean  @default(false) @map("is_statutory")
  // Which statutory rule the run engine applies when resolving this
  // component's amount, on top of calculationType — null for anything
  // that's just a plain flat/percent figure with no special government
  // rule attached. PF caps the % against CompanyProfile.pfWageCeiling
  // instead of the raw Basic; ESI zeroes out once gross exceeds
  // esiGrossThreshold; PT looks up PtSlab by gross instead of using this
  // row's stored value/percent at all. See runEngine.ts.
  statutoryType   String?  @map("statutory_type") // PF | ESI | PT | null
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  structureComponents SalaryStructureComponent[]
  payslipLineItems    PayslipLineItem[]

  @@map("salary_components")
}

// A named, reusable CTC template ("Standard L1") — built once, assigned to
// many employees via SalaryStructureAssignment below.
model SalaryStructure {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  components  SalaryStructureComponent[]
  assignments SalaryStructureAssignment[]

  @@map("salary_structures")
}

// One row per component included in a structure. `value` is either a flat
// rupee amount or a percent-of-basic figure, per the component's own
// calculationType — this table doesn't duplicate that flag, it just holds
// the number the structure uses for it.
model SalaryStructureComponent {
  id          Int     @id @default(autoincrement())
  structureId Int     @map("structure_id")
  componentId Int     @map("component_id")
  value       Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  structure SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  component SalaryComponent @relation(fields: [componentId], references: [id])

  @@unique([structureId, componentId])
  @@map("salary_structure_components")
}

// Links an Employee to a SalaryStructure with a CTC and an effective-date
// range — an increment adds a new row (closing the previous one's
// effectiveTo) instead of overwriting history, the same way ExchangeRate
// keeps a full rate history rather than a single mutable current value.
// `version` is the same optimistic-lock convention AdminTicket uses on
// updates that must not silently clobber a concurrent edit.
model SalaryStructureAssignment {
  id            Int       @id @default(autoincrement())
  employeeId    Int       @map("employee_id")
  structureId   Int       @map("structure_id")
  ctcAnnual     Decimal   @map("ctc_annual") @db.Decimal(14, 2)
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdById   Int?      @map("created_by")
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  employee  Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  structure SalaryStructure            @relation(fields: [structureId], references: [id])
  revisions SalaryAssignmentRevision[]

  @@index([employeeId, effectiveFrom])
  @@map("salary_structure_assignments")
}

// A revision changes an assignment's CTC while keeping a permanent
// before/after record, same shape as ExpenseBudgetRevision — the assignment
// row is updated in place (payroll runs always read the current CTC) and
// this is the append-only history of how it got there. structureId/
// employeeId/effectiveFrom are edited directly on the assignment itself
// (plain PATCH, no revision) since only the monetary value needs an
// audited trail; revisedById is a loose reference to User.id, not a
// relation, matching SalaryStructureAssignment.createdById above.
model SalaryAssignmentRevision {
  id           Int      @id @default(autoincrement())
  assignmentId Int      @map("assignment_id")
  previousCtc  Decimal  @map("previous_ctc") @db.Decimal(14, 2)
  newCtc       Decimal  @map("new_ctc") @db.Decimal(14, 2)
  reason       String?
  revisedById  Int?     @map("revised_by")
  createdAt    DateTime @default(now()) @map("created_at")

  assignment SalaryStructureAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@map("salary_assignment_revisions")
}

// Payroll Phase 2 — one row per calendar month. Full status-transition
// matrix (DRAFT/APPROVED/PROCESSED/PAID/CANCELLED, every status reachable
// from every other) rather than a rigid one-way pipeline, mirroring
// AdminTicket's STATUSES/isValidStatusTransition — a mistaken approval can
// be reopened to DRAFT rather than needing a whole new run. Payslip edits
// (LOP days, adjustments) are only allowed while status is DRAFT.
model PayrollRun {
  id             Int       @id @default(autoincrement())
  payPeriodYear  Int       @map("pay_period_year")
  payPeriodMonth Int       @map("pay_period_month") // 1-12
  status         String    @default("DRAFT")
  initiatedById  Int?      @map("initiated_by")
  approvedById   Int?      @map("approved_by")
  approvedAt     DateTime? @map("approved_at")
  processedAt    DateTime? @map("processed_at")
  paidAt         DateTime? @map("paid_at")
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  payslips Payslip[]

  @@unique([payPeriodYear, payPeriodMonth])
  @@map("payroll_runs")
}

// One per employee per run. Structure-component amounts are pro-rated by
// payableDays/totalDays (LOP + partial-month joining/exit); adjustments
// (bonus, arrears, reimbursement, ad-hoc deduction) are added on top,
// unscaled, as their own PayslipLineItem rows — see runEngine.ts for the
// actual computation and its stated assumptions.
model Payslip {
  id              Int      @id @default(autoincrement())
  runId           Int      @map("run_id")
  employeeId      Int      @map("employee_id")
  assignmentId    Int?     @map("assignment_id")
  totalDays       Int      @map("total_days")
  payableDays     Decimal  @map("payable_days") @db.Decimal(4, 1)
  lopDays         Decimal  @default(0) @map("lop_days") @db.Decimal(4, 1)
  grossEarnings   Decimal  @map("gross_earnings") @db.Decimal(14, 2)
  totalDeductions Decimal  @map("total_deductions") @db.Decimal(14, 2)
  netPay          Decimal  @map("net_pay") @db.Decimal(14, 2)
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  run       PayrollRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee  Employee          @relation(fields: [employeeId], references: [id])
  lineItems PayslipLineItem[]

  @@unique([runId, employeeId])
  @@map("payslips")
}

// componentId is null for ad-hoc adjustment rows (bonus/arrears/
// reimbursement/extra deduction) that aren't tied to a structure
// component; label/type are snapshotted onto the row either way so a
// payslip still reads correctly even if the component is later renamed or
// deactivated.
model PayslipLineItem {
  id           Int     @id @default(autoincrement())
  payslipId    Int     @map("payslip_id")
  componentId  Int?    @map("component_id")
  label        String
  type         String // EARNING | DEDUCTION
  amount       Decimal @db.Decimal(12, 2)
  isAdjustment Boolean @default(false) @map("is_adjustment")

  payslip   Payslip          @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  component SalaryComponent? @relation(fields: [componentId], references: [id])

  @@map("payslip_line_items")
}

// Payroll Phase 4 — Professional Tax slabs. PT is state-specific and
// changes by government notification, so it's data (admin-editable),
// not a constant in code. effectiveFrom lets a rate change apply going
// forward without rewriting history on already-PAID runs (matching the
// same effective-dating convention as SalaryStructureAssignment and
// ExchangeRate). maxGross is nullable for the open-ended top slab.
model PtSlab {
  id            Int      @id @default(autoincrement())
  state         String   @default("TN")
  minGross      Decimal  @map("min_gross") @db.Decimal(12, 2)
  maxGross      Decimal? @map("max_gross") @db.Decimal(12, 2)
  monthlyAmount Decimal  @map("monthly_amount") @db.Decimal(12, 2)
  effectiveFrom DateTime @default(now()) @map("effective_from")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([state, isActive])
  @@map("pt_slabs")
}

// Payroll Phase 5 (Attendance & Leave) — a named leave type (Casual,
// Sick, Earned, Loss of Pay, ...). annualQuota is null for an unlimited
// type (LOP itself — anyone can take unpaid leave without a cap);
// isPaid=false is what makes a type actually reduce payableDays in a
// payroll run, via computeAutoLopDays() in leaveEngine.ts.
model LeaveType {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique
  isPaid      Boolean  @default(true) @map("is_paid")
  annualQuota Decimal? @map("annual_quota") @db.Decimal(5, 1)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  requests LeaveRequest[]

  @@map("leave_types")
}

// No separate LeaveBalance table — "days used" is always summed live from
// APPROVED requests rather than tracked as a mutable running total, so
// there's exactly one source of truth and nothing to keep in sync. Simple
// linear workflow (PENDING -> APPROVED/REJECTED by an approver, or ->
// CANCELLED by the employee themselves) rather than PayrollRun's full
// reversible matrix — a rejected or cancelled leave request doesn't get
// reopened, the employee just applies again. No holiday-calendar or
// weekend exclusion in this phase — `days` is the calendar span the
// employee (or the UI) states, start through end inclusive.
model LeaveRequest {
  id           Int       @id @default(autoincrement())
  employeeId   Int       @map("employee_id")
  leaveTypeId  Int       @map("leave_type_id")
  startDate    DateTime  @map("start_date")
  endDate      DateTime  @map("end_date")
  days         Decimal   @db.Decimal(5, 1)
  reason       String?
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  appliedAt    DateTime  @default(now()) @map("applied_at")
  approvedById Int?      @map("approved_by")
  approvedAt   DateTime? @map("approved_at")
  decisionNote String?   @map("decision_note")
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId, startDate])
  @@map("leave_requests")
}

// Payroll Phase 5 (Loans & Advances) — outstandingBalance starts equal to
// principal and is only ever decremented when a run holding a repayment
// reaches PROCESSED (see changeRunStatus in runService.ts), and added
// back if that run is reopened to DRAFT — the same reversible-on-reopen
// philosophy PayrollRun itself uses, so a loan's balance never drifts
// out of sync with what was actually processed.
model Loan {
  id                 Int      @id @default(autoincrement())
  employeeId         Int      @map("employee_id")
  principal          Decimal  @db.Decimal(12, 2)
  reason             String?
  disbursedDate      DateTime @map("disbursed_date")
  monthlyInstallment Decimal  @map("monthly_installment") @db.Decimal(12, 2)
  outstandingBalance Decimal  @map("outstanding_balance") @db.Decimal(12, 2)
  status             String   @default("ACTIVE") // ACTIVE | CLOSED | CANCELLED
  createdById        Int?     @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  repayments LoanRepayment[]

  @@map("loans")
}

// One row per "this loan had an installment applied to this run" — the
// audit trail `Loan.outstandingBalance` is derived from, and what makes
// the DRAFT->PROCESSED->DRAFT reversal in changeRunStatus safe: it's what
// gets flipped between PENDING (tentative, added while the run is still
// DRAFT) and APPLIED (the balance has actually been decremented). A
// regenerate on a still-DRAFT run deletes PENDING rows for that run
// (see /api/payroll/runs/[id]/regenerate) since the payslip line item
// they refer to gets wiped too.
model LoanRepayment {
  id        Int      @id @default(autoincrement())
  loanId    Int      @map("loan_id")
  runId     Int      @map("run_id")
  payslipId Int?     @map("payslip_id")
  amount    Decimal  @db.Decimal(12, 2)
  status    String   @default("PENDING") // PENDING | APPLIED
  createdAt DateTime @default(now()) @map("created_at")

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, runId])
  @@map("loan_repayments")
}

// Time & Attendance — one row per employee per calendar month, holding
// admin-entered Regular/Overtime hour totals for that pay period. Deliberately
// a period total rather than a daily punch-clock log (no clock-in/out or
// per-day grid exists in this app): HR/an admin fills in the two numbers for
// the month, the same granularity PayrollRun already works at. Sick Leave,
// PTO, and Paid Holiday hours are NOT stored here — they're derived live from
// LeaveRequest and PaidHoliday, the same "no duplicate source of truth"
// convention LeaveRequest.days uses instead of a separate LeaveBalance table.
model TimesheetEntry {
  id            Int      @id @default(autoincrement())
  employeeId    Int      @map("employee_id")
  periodYear    Int      @map("period_year")
  periodMonth   Int      @map("period_month") // 1-12
  regularHours  Decimal  @default(0) @map("regular_hours") @db.Decimal(6, 1)
  overtimeHours Decimal  @default(0) @map("overtime_hours") @db.Decimal(6, 1)
  updatedById   Int?     @map("updated_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, periodYear, periodMonth])
  @@map("timesheet_entries")
}

// One row per company holiday (Republic Day, Diwali, ...) — feeds the
// "Paid Holiday" hours column of a timesheet (8h × every holiday that falls
// within the period and within the employee's employment dates). Not
// state/branch-scoped in this phase, matching PtSlab's TN-only starting
// scope — a single shared calendar is enough for a single-location company.
model PaidHoliday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @db.Date
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("paid_holidays")
}

// One row per calendar month — whether that month's timesheet has been
// "Send to Payroll"'d yet. OPEN is editable; SUBMITTED locks TimesheetEntry
// edits for that month (enforced in the API, not the schema) and can be
// reopened back to OPEN, the same one-step-reversible convention PayrollRun
// uses for its own status rather than a one-way pipeline.
model TimesheetPeriod {
  id            Int       @id @default(autoincrement())
  periodYear    Int       @map("period_year")
  periodMonth   Int       @map("period_month")
  status        String    @default("OPEN") // OPEN | SUBMITTED
  submittedById Int?      @map("submitted_by")
  submittedAt   DateTime? @map("submitted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([periodYear, periodMonth])
  @@map("timesheet_periods")
}

model StatusMaster {
  id           Int     @id @default(autoincrement())
  module       String
  statusValue  String  @map("status_value")
  displayLabel String  @map("display_label")
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")
  color        String?
  description  String?

  @@unique([module, statusValue])
  @@map("status_master")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  action      String
  entityType  String?  @map("entity_type")
  entityId    Int?     @map("entity_id")
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  ipAddress   String?  @map("ip_address")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// ACCOUNTING
// ============================================================

model Invoice {
  id                 Int       @id @default(autoincrement())
  invoiceNumber      String    @unique @map("invoice_number")
  leadId             Int       @map("lead_id")
  quotationId        Int?      @map("quotation_id")
  // Carried over from the source Quotation's legalEntityId (see
  // invoiceFromQuotation.ts) so an invoice generated from a quotation billed
  // to a specific country entity stays traceable to it, even if the
  // quotation is later edited.
  legalEntityId      Int?      @map("legal_entity_id")
  invoiceDate        DateTime  @default(now()) @map("invoice_date")
  dueDate            DateTime  @map("due_date")
  lineItems          Json      @map("line_items")
  subtotal           Decimal   @db.Decimal(15, 2)
  discountPercentage Decimal?  @map("discount_percentage") @db.Decimal(5, 2)
  discountAmount     Decimal?  @map("discount_amount") @db.Decimal(15, 2)
  taxBreakdown       Json?     @map("tax_breakdown")
  taxAmount          Decimal?  @map("tax_amount") @db.Decimal(15, 2)
  totalAmount        Decimal   @map("total_amount") @db.Decimal(15, 2)
  amountPaid         Decimal   @default(0) @map("amount_paid") @db.Decimal(15, 2)
  balanceDue         Decimal   @map("balance_due") @db.Decimal(15, 2)
  currencyCode       String    @default("INR") @map("currency_code")
  exchangeRate       Decimal?  @default(1) @map("exchange_rate") @db.Decimal(15, 6)
  status             String    @default("PENDING") @map("status") // PENDING | PARTIALLY_PAID | PAID | CANCELLED
  accountManagerId   Int?      @map("account_manager_id")
  notes              String?
  createdById        Int?      @map("created_by")
  updatedById        Int?      @map("updated_by")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  lead           Lead                @relation(fields: [leadId], references: [id])
  quotation      Quotation?          @relation(fields: [quotationId], references: [id])
  legalEntity    CompanyLegalEntity? @relation(fields: [legalEntityId], references: [id])
  accountManager User?               @relation("InvoiceAccountManager", fields: [accountManagerId], references: [id])
  createdBy      User?               @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  updatedBy      User?               @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id])
  payments       Payment[]
  reminders      PaymentReminder[]
  creditNotes    CreditNote[]

  @@index([status])
  @@index([leadId])
  @@index([dueDate])
  @@index([accountManagerId])
  @@index([legalEntityId])
  @@map("invoices")
}

model Payment {
  id              Int       @id @default(autoincrement())
  paymentNumber   String    @unique @map("payment_number")
  invoiceId       Int       @map("invoice_id")
  // Amount applied to the invoice, in the INVOICE's currency (unchanged
  // meaning — every existing report/PDF/list assumes this). When the payer
  // paid in a different currency (currencyCode below), this is the
  // converted result, not what they actually handed over.
  amount          Decimal   @db.Decimal(15, 2)
  // Currency the payer actually paid in — defaults to the invoice's own
  // currency (the common case, where no conversion is needed).
  currencyCode    String    @default("INR") @map("currency_code")
  // Snapshot of the rate used to convert currencyCode -> invoice.currencyCode
  // at the time this payment was recorded. 1 when currencyCode matches the
  // invoice's currency.
  exchangeRate    Decimal   @default(1) @map("exchange_rate") @db.Decimal(15, 6)
  // The amount as entered by the payer, in currencyCode, before conversion.
  // Equal to `amount` when currencyCode matches the invoice's currency.
  // Storing both (never just the converted figure) keeps this auditable.
  paidAmount      Decimal   @map("paid_amount") @db.Decimal(15, 2)
  paymentDate     DateTime  @default(now()) @map("payment_date")
  paymentMethod   String    @map("payment_method") // CASH | BANK_TRANSFER | CHEQUE | CARD | UPI | OTHER
  referenceNumber String?   @map("reference_number")
  attachmentUrl   String?   @map("attachment_url")
  attachmentName  String?   @map("attachment_name")
  notes           String?
  recordedById    Int?      @map("recorded_by")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  recordedBy User?   @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@index([paymentDate])
  @@map("payments")
}

model PaymentReminder {
  id             Int       @id @default(autoincrement())
  invoiceId      Int       @map("invoice_id")
  reminderType   String    @map("reminder_type") // UPCOMING_7D | DUE_TODAY | OVERDUE_3D | OVERDUE_7D | OVERDUE_15D | OVERDUE_30D
  status         String    @default("PENDING") // PENDING | FOLLOWED_UP
  notes          String?
  followedUpAt   DateTime? @map("followed_up_at")
  followedUpById Int?      @map("followed_up_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  invoice      Invoice @relation(fields: [invoiceId], references: [id])
  followedUpBy User?   @relation("ReminderFollowedUpBy", fields: [followedUpById], references: [id])

  @@unique([invoiceId, reminderType])
  @@index([invoiceId])
  @@map("payment_reminders")
}

model ReminderTemplate {
  id           Int      @id @default(autoincrement())
  name         String
  reminderType String   @map("reminder_type") // matches PaymentReminder.reminderType, or CUSTOM
  channel      String // EMAIL | WHATSAPP
  subject      String?
  body         String // supports {{customerName}}, {{invoiceNumber}}, {{amountDue}}, {{dueDate}} tokens
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("reminder_templates")
}

model CreditNote {
  id               Int       @id @default(autoincrement())
  creditNoteNumber String    @unique @map("credit_note_number")
  invoiceId        Int?      @map("invoice_id")
  leadId           Int       @map("lead_id")
  amount           Decimal   @db.Decimal(15, 2)
  reason           String?
  issuedById       Int?      @map("issued_by")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  invoice  Invoice? @relation(fields: [invoiceId], references: [id])
  lead     Lead     @relation(fields: [leadId], references: [id])
  issuedBy User?    @relation("CreditNoteIssuedBy", fields: [issuedById], references: [id])

  @@index([leadId])
  @@map("credit_notes")
}

// The mirror-image ledger of Invoice/Payment — money going out instead of
// coming in. Deliberately simpler than Invoice: a single amount/status per
// row (no partial-payment accumulation, no approval workflow), since this
// is company/admin-recorded spend, not an employee claim needing sign-off.
model ExpenseCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  expenses      Expense[]
  budgets       ExpenseBudget[]
  subCategories ExpenseSubCategory[]

  @@map("expense_categories")
}

// A category's sub-categories (e.g. "Subscriptions" -> "Cursor"/"Claude") —
// scoped to one parent category rather than a flat/global list, since the
// same sub-category name has no meaning outside its category.
model ExpenseSubCategory {
  id         Int      @id @default(autoincrement())
  categoryId Int      @map("category_id")
  name       String
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category ExpenseCategory @relation(fields: [categoryId], references: [id])
  expenses Expense[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("expense_sub_categories")
}

model Expense {
  id              Int       @id @default(autoincrement())
  expenseNumber   String    @unique @map("expense_number")
  categoryId      Int       @map("category_id")
  subCategoryId   Int?      @map("sub_category_id")
  vendor          String?
  expenseDate     DateTime  @map("expense_date")
  amount          Decimal   @db.Decimal(14, 2)
  currencyCode    String    @default("INR") @map("currency_code")
  // Snapshot of the rate to the base currency at record time — same
  // auditability reasoning as Payment.exchangeRate: never recompute
  // historical expenses against today's rate.
  exchangeRate    Decimal   @default(1) @map("exchange_rate") @db.Decimal(15, 6)
  paymentMethod   String    @map("payment_method") // CASH | BANK_TRANSFER | CHEQUE | CARD | UPI | OTHER
  status          String    @default("PENDING") // PENDING | PAID
  paidDate        DateTime? @map("paid_date")
  referenceNumber String?   @map("reference_number") // vendor's bill/receipt number
  attachmentUrl   String?   @map("attachment_url")
  attachmentName  String?   @map("attachment_name")
  notes           String?
  recordedById    Int?      @map("recorded_by")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  category    ExpenseCategory     @relation(fields: [categoryId], references: [id])
  subCategory ExpenseSubCategory? @relation(fields: [subCategoryId], references: [id])
  recordedBy  User?               @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])

  @@index([status])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([expenseDate])
  @@map("expenses")
}

// ============================================================
// VERTICALS & EXPENSE BUDGET (BRD §6, §10 — vertical-wise budgeting)
//
// Vertical carries just what its own admin screen needs (name, head,
// headline budget) plus the code every other module keys off. Wiring
// verticalId onto Lead/Implementation/Employee (and backfilling their
// existing free-text businessVerticals values) is separate follow-on work,
// not required for this screen or for ExpenseBudget to be useful on
// their own. `budget` here is a simple headline figure the vertical's own
// admin screen edits directly — a separate, simpler thing from the
// category-by-month ExpenseBudget rows below, which stay the source of
// truth for actual Budget vs Actual variance reporting.
// ============================================================

model Vertical {
  id                 Int      @id @default(autoincrement())
  name               String   @unique
  code               String   @unique
  headId             Int?     @map("head_id")
  budget             Decimal? @map("budget") @db.Decimal(15, 2)
  budgetCurrencyCode String?  @default("INR") @map("budget_currency_code")
  isActive           Boolean  @default(true) @map("is_active")
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  head       User?           @relation("VerticalHead", fields: [headId], references: [id])
  budgets    ExpenseBudget[]
  quotations Quotation[]

  @@map("verticals")
}

model ExpenseBudget {
  id                 Int       @id @default(autoincrement())
  financialYearStart DateTime  @map("financial_year_start")
  financialYearEnd   DateTime  @map("financial_year_end")
  verticalId         Int?      @map("vertical_id") // null = company-wide
  categoryId         Int       @map("category_id")
  totalAmount        Decimal   @map("total_amount") @db.Decimal(15, 2)
  currencyCode       String    @default("INR") @map("currency_code")
  status             String    @default("DRAFT") // DRAFT | APPROVED
  notes              String?
  approvedById       Int?      @map("approved_by")
  approvedAt         DateTime? @map("approved_at")
  createdById        Int?      @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  vertical   Vertical?               @relation(fields: [verticalId], references: [id])
  category   ExpenseCategory         @relation(fields: [categoryId], references: [id])
  approvedBy User?                   @relation("ExpenseBudgetApprovedBy", fields: [approvedById], references: [id])
  createdBy  User?                   @relation("ExpenseBudgetCreatedBy", fields: [createdById], references: [id])
  months     ExpenseBudgetMonth[]
  revisions  ExpenseBudgetRevision[]

  // One budget per financial-year/vertical/category combination — a second
  // budget for the same slice should be a revision of this one, not a
  // sibling row competing with it in variance reports.
  @@unique([financialYearStart, verticalId, categoryId])
  @@index([verticalId])
  @@index([categoryId])
  @@index([status])
  @@map("expense_budgets")
}

// The monthly spread that makes "month-wise Budget vs Actual" (BRD §6, §9)
// possible — a budget's totalAmount is the sum of its months, enforced in
// application code at write time (see /api/expense-budgets) rather than a
// DB constraint, matching this codebase's existing convention of validating
// cross-row invariants in the route handler.
model ExpenseBudgetMonth {
  id       Int      @id @default(autoincrement())
  budgetId Int      @map("budget_id")
  month    DateTime // first day of the month, e.g. 2026-08-01
  amount   Decimal  @db.Decimal(15, 2)

  budget ExpenseBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, month])
  @@map("expense_budget_months")
}

model ExpenseBudgetRevision {
  id             Int      @id @default(autoincrement())
  budgetId       Int      @map("budget_id")
  previousAmount Decimal  @map("previous_amount") @db.Decimal(15, 2)
  newAmount      Decimal  @map("new_amount") @db.Decimal(15, 2)
  reason         String?
  revisedById    Int?     @map("revised_by")
  createdAt      DateTime @default(now()) @map("created_at")

  budget    ExpenseBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  revisedBy User?         @relation("ExpenseBudgetRevisedBy", fields: [revisedById], references: [id])

  @@map("expense_budget_revisions")
}

// ============================================================
// ADMIN TICKET MODULE (office-admin task tracker)
//
// Fully additive, feature-flagged (FEATURE_ADMIN_TICKET) module — own
// tables only, no columns added to and no FKs pointing at existing tables.
// assignedToId/createdById/completedById/performedById/uploadedById below
// are loose references to User.id (and escalationRoleId to Role.id): plain
// Int columns with no @relation, resolved via a separate read when needed.
// This is deliberate, not an oversight — a real FK would mean deactivating
// or deleting a User/Role could fail because of a row in this module.
// ============================================================

model AdminTicketCategory {
  id               Int      @id @default(autoincrement())
  name             String
  code             String   @unique
  defaultPriority  String   @default("MEDIUM") @map("default_priority") // LOW | MEDIUM | HIGH | CRITICAL
  defaultSlaDays   Int?     @map("default_sla_days")
  escalationRoleId Int?     @map("escalation_role_id") // loose ref to Role.id, no FK
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tickets AdminTicket[]

  @@map("admin_ticket_categories")
}

model AdminTicket {
  id             Int       @id @default(autoincrement())
  ticketNo       String    @unique @map("ticket_no")
  categoryId     Int       @map("category_id")
  title          String
  description    String?
  priority       String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status         String    @default("OPEN") // OPEN | IN_PROGRESS | PENDING | COMPLETED | CANCELLED
  assignedToId   Int?      @map("assigned_to") // loose ref to User.id
  createdById    Int?      @map("created_by") // loose ref to User.id
  dueDate        DateTime? @map("due_date")
  completedAt    DateTime? @map("completed_at")
  completedById  Int?      @map("completed_by") // loose ref to User.id
  recurrenceId   Int?      @map("recurrence_id")
  parentTicketId Int?      @map("parent_ticket_id")
  refType        String?   @map("ref_type") // loose link to an existing entity, e.g. "LEAD" | "EVENT"
  refId          Int?      @map("ref_id") // no FK — see module note above
  isActive       Boolean   @default(true) @map("is_active")
  version        Int       @default(1) // optimistic-lock token for concurrent completes
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  category     AdminTicketCategory     @relation(fields: [categoryId], references: [id])
  recurrence   AdminTicketRecurrence?  @relation(fields: [recurrenceId], references: [id])
  parentTicket AdminTicket?            @relation("AdminTicketOccurrences", fields: [parentTicketId], references: [id])
  occurrences  AdminTicket[]           @relation("AdminTicketOccurrences")
  reminders    AdminTicketReminder[]
  activities   AdminTicketActivity[]
  attachments  AdminTicketAttachment[]
  comments     AdminTicketComment[]

  @@unique([recurrenceId, dueDate])
  @@index([status, dueDate])
  @@index([categoryId])
  @@index([assignedToId])
  @@index([recurrenceId])
  @@index([refType, refId])
  @@map("admin_tickets")
}

model AdminTicketRecurrence {
  id                Int       @id @default(autoincrement())
  frequency         String // DAILY | WEEKLY | MONTHLY | QUARTERLY | YEARLY | CUSTOM_CRON
  intervalValue     Int       @default(1) @map("interval_value")
  dayOfMonth        Int?      @map("day_of_month")
  dayOfWeek         Int?      @map("day_of_week") // 0 (Sun) - 6 (Sat)
  monthOfYear       Int?      @map("month_of_year") // 1-12, used by YEARLY
  startDate         DateTime  @map("start_date")
  endDate           DateTime? @map("end_date")
  nextRunDate       DateTime  @map("next_run_date")
  lastGeneratedDate DateTime? @map("last_generated_date")
  leadTimeDays      Int       @default(0) @map("lead_time_days") // generate the occurrence N days before it's due
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  occurrences AdminTicket[]

  @@index([isActive, nextRunDate])
  @@map("admin_ticket_recurrences")
}

model AdminTicketReminder {
  id            Int       @id @default(autoincrement())
  ticketId      Int       @map("ticket_id")
  offsetDays    Int       @map("offset_days") // negative = before due, positive = overdue nudge
  channel       String // EMAIL | SMS | WHATSAPP | IN_APP | PUSH
  recipientType String    @map("recipient_type") // ASSIGNEE | CREATOR | ROLE | EXPLICIT
  recipientRef  String?   @map("recipient_ref")
  scheduledAt   DateTime  @map("scheduled_at")
  status        String    @default("PENDING") // PENDING | SENT | FAILED | SKIPPED | CANCELLED
  attemptCount  Int       @default(0) @map("attempt_count")
  lastError     String?   @map("last_error")
  sentAt        DateTime? @map("sent_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  ticket AdminTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, offsetDays, channel, recipientType])
  @@index([scheduledAt, status])
  @@index([ticketId])
  @@map("admin_ticket_reminders")
}

// Append-only audit trail — rows are only ever inserted, never updated or
// deleted, matching AuditLog's pattern elsewhere in this schema.
model AdminTicketActivity {
  id            Int      @id @default(autoincrement())
  ticketId      Int      @map("ticket_id")
  action        String
  fieldName     String?  @map("field_name")
  oldValue      String?  @map("old_value")
  newValue      String?  @map("new_value")
  performedById Int?     @map("performed_by") // loose ref to User.id
  performedAt   DateTime @default(now()) @map("performed_at")
  remarks       String?

  ticket AdminTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([performedAt])
  @@map("admin_ticket_activities")
}

// Freeform human discussion on a ticket, kept separate from
// AdminTicketActivity (system-generated field-change/status audit trail) —
// same separation of concerns as EventDiscussion vs LeadActivity elsewhere
// in this schema. Create-only for v1; no edit/delete.
model AdminTicketComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int      @map("ticket_id")
  body      String
  authorId  Int?     @map("author_id") // loose ref to User.id
  createdAt DateTime @default(now()) @map("created_at")

  ticket AdminTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("admin_ticket_comments")
}

model AdminTicketAttachment {
  id           Int      @id @default(autoincrement())
  ticketId     Int      @map("ticket_id")
  fileName     String   @map("file_name")
  filePath     String   @map("file_path") // Vercel Blob URL
  mimeType     String?  @map("mime_type")
  size         Int?
  uploadedById Int?     @map("uploaded_by") // loose ref to User.id
  createdAt    DateTime @default(now()) @map("created_at")

  ticket AdminTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("admin_ticket_attachments")
}

// ============================================================
// MEETING MANAGEMENT MODULE (Phase 1 — scheduling, participants, agenda)
//
// Fully additive, feature-flagged (FEATURE_MEETINGS) module, same
// convention as ADMIN TICKET MODULE above — own tables only. organizerId/
// createdById/performedById/uploadedById/ownerId are loose references to
// User.id (plain Int, no @relation): deactivating or deleting a User must
// never fail because of a row in this module. MOM, Action Items, SLA, and
// notification-template/preference tables are later phases and are not
// created yet — meeting_attachments' entityType already anticipates them
// (MOM | ACTION_ITEM) so it doesn't need to change shape when they land.
// ============================================================

model Meeting {
  id              Int      @id @default(autoincrement())
  title           String
  meetingType     String   @map("meeting_type") // INTERNAL | CLIENT | VENDOR | REVIEW | OTHER | TO_DO
  purpose         String?
  scheduledAt     DateTime @map("scheduled_at")
  durationMinutes Int?     @map("duration_minutes")
  location        String?
  meetingLink     String?  @map("meeting_link")
  organizerId     Int?     @map("organizer_id") // loose ref to User.id
  priority        String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  status          String   @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED — rescheduling updates scheduledAt + logs a RESCHEDULED activity, it isn't its own status
  refType         String?  @map("ref_type") // loose link to an existing entity, e.g. "LEAD" | "IMPLEMENTATION" | "ADMIN_TICKET"
  refId           Int?     @map("ref_id") // no FK — see module note above
  recurrenceId    Int?     @map("recurrence_id")
  parentMeetingId Int?     @map("parent_meeting_id")
  version         Int      @default(1) // optimistic-lock token for concurrent edits
  createdById     Int?     @map("created_by") // loose ref to User.id
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  recurrence    MeetingRecurrence?   @relation(fields: [recurrenceId], references: [id])
  parentMeeting Meeting?             @relation("MeetingOccurrences", fields: [parentMeetingId], references: [id])
  occurrences   Meeting[]            @relation("MeetingOccurrences")
  participants  MeetingParticipant[]
  agendaItems   MeetingAgendaItem[]
  activities    MeetingActivity[]
  mom           Mom?
  actionItems   ActionItem[]

  @@unique([recurrenceId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([organizerId])
  @@index([refType, refId])
  @@index([recurrenceId])
  @@map("meetings")
}

model MeetingRecurrence {
  id                Int       @id @default(autoincrement())
  frequency         String // DAILY | WEEKLY | MONTHLY | QUARTERLY | YEARLY | CUSTOM_CRON
  intervalValue     Int       @default(1) @map("interval_value")
  dayOfMonth        Int?      @map("day_of_month")
  dayOfWeek         Int?      @map("day_of_week") // 0 (Sun) - 6 (Sat)
  monthOfYear       Int?      @map("month_of_year") // 1-12, used by YEARLY
  startDate         DateTime  @map("start_date")
  endDate           DateTime? @map("end_date")
  nextRunDate       DateTime  @map("next_run_date")
  lastGeneratedDate DateTime? @map("last_generated_date")
  leadTimeDays      Int       @default(0) @map("lead_time_days") // generate the occurrence N days before it's due
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  occurrences Meeting[]

  @@index([isActive, nextRunDate])
  @@map("meeting_recurrences")
}

model MeetingParticipant {
  id              Int      @id @default(autoincrement())
  meetingId       Int      @map("meeting_id")
  participantType String   @map("participant_type") // INTERNAL | EXTERNAL
  userId          Int?     @map("user_id") // loose ref to User.id, set when participantType=INTERNAL
  externalName    String?  @map("external_name")
  externalEmail   String?  @map("external_email")
  role            String   @default("ATTENDEE") // ORGANIZER | ATTENDEE | OPTIONAL
  rsvpStatus      String   @default("PENDING") @map("rsvp_status") // PENDING | ACCEPTED | DECLINED | TENTATIVE
  attended        Boolean?
  createdAt       DateTime @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([userId])
  @@map("meeting_participants")
}

model MeetingAgendaItem {
  id                   Int      @id @default(autoincrement())
  meetingId            Int      @map("meeting_id")
  sortOrder            Int      @default(0) @map("sort_order")
  title                String
  description          String?
  timeAllocatedMinutes Int?     @map("time_allocated_minutes")
  ownerId              Int?     @map("owner_id") // loose ref to User.id
  status               String   @default("PENDING") // PENDING | DISCUSSED | DEFERRED
  createdAt            DateTime @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_agenda_items")
}

// Append-only audit trail — same separation of concerns as
// AdminTicketActivity: system-generated field-change/status trail, not
// freeform human discussion (there's no MeetingComment yet; add one the
// same way AdminTicketComment was added if this module needs it).
model MeetingActivity {
  id            Int      @id @default(autoincrement())
  meetingId     Int      @map("meeting_id")
  action        String
  fieldName     String?  @map("field_name")
  oldValue      String?  @map("old_value")
  newValue      String?  @map("new_value")
  performedById Int?     @map("performed_by") // loose ref to User.id
  performedAt   DateTime @default(now()) @map("performed_at")
  remarks       String?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([performedAt])
  @@map("meeting_activities")
}

// Polymorphic on purpose — meetings, and later MOM/action items (once those
// tables exist), all attach files through this one table instead of three
// near-identical ones. No FK, matches the Notification/AuditLog entityType/
// entityId idiom already used elsewhere in this schema.
model MeetingAttachment {
  id           Int      @id @default(autoincrement())
  entityType   String   @map("entity_type") // MEETING | MOM | ACTION_ITEM
  entityId     Int      @map("entity_id")
  fileName     String   @map("file_name")
  filePath     String   @map("file_path") // Vercel Blob URL
  mimeType     String?  @map("mime_type")
  size         Int?
  uploadedById Int?     @map("uploaded_by") // loose ref to User.id
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("meeting_attachments")
}

// ============================================================
// MOM MODULE (Phase 2 — Minutes of Meeting authoring/approval/publish)
//
// One Mom per Meeting (moms.meetingId is unique — a real FK, cascading with
// the meeting it belongs to, unlike the loose refs elsewhere in this
// module). Lifecycle events (submitted/approved/rejected/published,
// decisions added) are logged into the existing MeetingActivity trail
// rather than a second per-MOM activity table, so a meeting's timeline
// stays in one place. createdById/approvedById/editedById/decidedById are
// loose refs to User.id, same reasoning as the rest of this module.
// ============================================================

model Mom {
  id           Int       @id @default(autoincrement())
  meetingId    Int       @unique @map("meeting_id")
  summary      String?
  risksIssues  String?   @map("risks_issues")
  status       String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED | PUBLISHED
  version      Int       @default(1) // optimistic-lock token for concurrent edits
  createdById  Int?      @map("created_by") // loose ref to User.id
  approvedById Int?      @map("approved_by") // loose ref to User.id
  approvedAt   DateTime? @map("approved_at")
  publishedAt  DateTime? @map("published_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  meeting     Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  decisions   MomDecision[]
  versions    MomVersion[]
  actionItems ActionItem[]

  @@index([status])
  @@map("moms")
}

// Snapshot of a Mom's content taken immediately BEFORE an edit is applied —
// versionNumber 1 is the state right after creation, each subsequent edit
// pushes the prior state as the next number. This is history, not the
// optimistic lock (that's Mom.version); read it to see what a MOM looked
// like before a given edit.
model MomVersion {
  id              Int      @id @default(autoincrement())
  momId           Int      @map("mom_id")
  versionNumber   Int      @map("version_number")
  contentSnapshot Json     @map("content_snapshot")
  editedById      Int?     @map("edited_by") // loose ref to User.id
  createdAt       DateTime @default(now()) @map("created_at")

  mom Mom @relation(fields: [momId], references: [id], onDelete: Cascade)

  @@unique([momId, versionNumber])
  @@map("mom_versions")
}

model MomDecision {
  id           Int      @id @default(autoincrement())
  momId        Int      @map("mom_id")
  decisionText String   @map("decision_text")
  decidedById  Int?     @map("decided_by") // loose ref to User.id
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  mom Mom @relation(fields: [momId], references: [id], onDelete: Cascade)

  @@index([momId])
  @@map("mom_decisions")
}

// ============================================================
// ACTION ITEM MODULE (Phase 3 — assignment, status workflow, follow-up,
// dependencies)
//
// meetingId is a real FK (cascades with its meeting, like MeetingActivity).
// momId is a real FK too but nullable + SET NULL on delete — an item can be
// added to a meeting directly, or generated from a MOM decision, and must
// survive if the MOM row is ever removed. assignedToId/assignedTeam(free
// text — no Team master exists yet)/createdById/completedById/verifiedById
// are loose refs to User.id, same reasoning as the rest of this module.
// Lifecycle events log into ActionItemHistory (append-only), mirroring
// AdminTicketActivity/MeetingActivity — separate from ActionItemComment
// (freeform human discussion), same separation of concerns used throughout
// this schema.
// ============================================================

model ActionItem {
  id                    Int       @id @default(autoincrement())
  meetingId             Int       @map("meeting_id")
  momId                 Int?      @map("mom_id")
  refType               String?   @map("ref_type") // loose link, e.g. "LEAD" | "IMPLEMENTATION" | "ADMIN_TICKET"
  refId                 Int?      @map("ref_id")
  description           String
  assignedToId          Int?      @map("assigned_to") // loose ref to User.id
  assignedTeam          String?   @map("assigned_team") // free-text — no Team master table exists yet
  priority              String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status                String    @default("DRAFT") // DRAFT | ASSIGNED | ACCEPTED | IN_PROGRESS | PENDING | BLOCKED | COMPLETED | VERIFIED | CLOSED | CANCELLED
  percentComplete       Int       @default(0) @map("percent_complete")
  dependsOnActionItemId Int?      @map("depends_on_action_item_id")
  startDate             DateTime? @map("start_date")
  dueDate               DateTime  @map("due_date")
  escalationLevel       Int       @default(0) @map("escalation_level") // advanced by the Phase 4 SLA engine, unused until then
  completedAt           DateTime? @map("completed_at")
  completedById         Int?      @map("completed_by") // loose ref to User.id
  verifiedById          Int?      @map("verified_by") // loose ref to User.id
  verifiedAt            DateTime? @map("verified_at")
  closureRemarks        String?   @map("closure_remarks")
  version               Int       @default(1) // optimistic-lock token for concurrent edits
  createdById           Int?      @map("created_by") // loose ref to User.id
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  meeting    Meeting              @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  mom        Mom?                 @relation(fields: [momId], references: [id], onDelete: SetNull)
  dependsOn  ActionItem?          @relation("ActionItemDependency", fields: [dependsOnActionItemId], references: [id])
  dependents ActionItem[]         @relation("ActionItemDependency")
  history    ActionItemHistory[]
  comments   ActionItemComment[]
  followUps  ActionItemFollowUp[]
  reminders  ActionItemReminder[]

  @@index([status, dueDate])
  @@index([assignedToId])
  @@index([meetingId])
  @@index([momId])
  @@index([refType, refId])
  @@index([dependsOnActionItemId])
  @@map("action_items")
}

// Append-only audit trail — same separation of concerns as
// AdminTicketActivity/MeetingActivity: system-generated field-change/
// status trail, not freeform human discussion (that's ActionItemComment).
model ActionItemHistory {
  id            Int      @id @default(autoincrement())
  actionItemId  Int      @map("action_item_id")
  action        String
  fieldName     String?  @map("field_name")
  oldValue      String?  @map("old_value")
  newValue      String?  @map("new_value")
  performedById Int?     @map("performed_by") // loose ref to User.id
  performedAt   DateTime @default(now()) @map("performed_at")
  remarks       String?

  actionItem ActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)

  @@index([actionItemId])
  @@index([performedAt])
  @@map("action_item_history")
}

// Freeform human discussion on an action item — create-only for v1, no
// edit/delete, same convention as AdminTicketComment/EventDiscussion.
model ActionItemComment {
  id           Int      @id @default(autoincrement())
  actionItemId Int      @map("action_item_id")
  body         String
  authorId     Int?     @map("author_id") // loose ref to User.id
  createdAt    DateTime @default(now()) @map("created_at")

  actionItem ActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)

  @@index([actionItemId])
  @@map("action_item_comments")
}

model ActionItemFollowUp {
  id               Int       @id @default(autoincrement())
  actionItemId     Int       @map("action_item_id")
  followUpDate     DateTime  @map("follow_up_date")
  frequency        String    @default("ONE_TIME") // ONE_TIME | DAILY | WEEKLY | MONTHLY
  nextFollowUpDate DateTime? @map("next_follow_up_date")
  ownerId          Int?      @map("owner_id") // loose ref to User.id
  remarks          String?
  status           String    @default("PENDING") // PENDING | COMPLETED
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  actionItem ActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)

  @@index([actionItemId])
  @@index([nextFollowUpDate])
  @@map("action_item_followups")
}

// ============================================================
// ACTION ITEM SLA ENGINE + NOTIFICATION TEMPLATES (Phase 4)
//
// ActionItemReminder mirrors AdminTicketReminder's materialize-then-dispatch
// shape (see reminderMaterializer.ts/dispatcher.ts precedent) — negative
// offsetDays are advance warnings to the assignee, 0/positive are overdue
// escalations that hand off to the meeting organizer as priority rises.
// NotificationTemplate is a fixed, pre-seeded set of (eventType, channel)
// rows (not user-creatable) so notification copy for SLA reminders and the
// one-off Meeting/MOM event notifications is admin-editable rather than a
// hardcoded string, mirroring ReminderTemplate's {{token}} convention in
// the accounting module.
// ============================================================

model ActionItemReminder {
  id            Int       @id @default(autoincrement())
  actionItemId  Int       @map("action_item_id")
  offsetDays    Int       @map("offset_days") // negative = advance warning, 0/positive = overdue escalation
  channel       String // IN_APP | EMAIL
  recipientType String    @map("recipient_type") // ASSIGNEE | ORGANIZER
  scheduledAt   DateTime  @map("scheduled_at")
  status        String    @default("PENDING") // PENDING | SENT | FAILED | SKIPPED | CANCELLED
  attemptCount  Int       @default(0) @map("attempt_count")
  lastError     String?   @map("last_error")
  sentAt        DateTime? @map("sent_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  actionItem ActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)

  @@unique([actionItemId, offsetDays, channel, recipientType])
  @@index([scheduledAt, status])
  @@index([actionItemId])
  @@map("action_item_reminders")
}

model NotificationTemplate {
  id        Int      @id @default(autoincrement())
  eventType String   @map("event_type") // ACTION_ITEM_DUE_SOON | ACTION_ITEM_OVERDUE | ACTION_ITEM_ESCALATED | MOM_PUBLISHED | MEETING_CANCELLED | MEETING_RESCHEDULED
  channel   String // IN_APP | EMAIL
  subject   String? // EMAIL only
  body      String // {{token}} substitution — see notificationTemplates.ts for the token set per eventType
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([eventType, channel])
  @@map("notification_templates")
}
